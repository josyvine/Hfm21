<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f1724"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- App Logo / Header Icon -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/hfm"
            android:contentDescription="HFM Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="HFM Network Setup"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Configure your private Firebase Database to host and send files securely."
            android:textColor="#9AA7BD"
            android:textSize="14sp" />

        <!-- Network Name Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Network / Company Name"
            android:textColor="#E6EEF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_company_name"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="e.g. My Private Network"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:textColor="#0f172a"
            android:textColorHint="#64748b"
            android:textSize="15sp" />

        <!-- Option 1: File Upload -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Option 1: Upload google-services.json"
            android:textColor="#E6EEF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_select_json"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#4F46E5"
            android:text="Select JSON File"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="No file selected"
            android:textColor="#10B981"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Divider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:text="— OR —"
            android:textColor="#9AA7BD"
            android:textSize="12sp" />

        <!-- Option 2: Paste Raw JSON Text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Option 2: Paste JSON Content Directly"
            android:textColor="#E6EEF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_paste_json"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/editbox_background_normal"
            android:gravity="top|start"
            android:hint="Paste raw google-services.json content here..."
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="#0f172a"
            android:textColorHint="#64748b"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progressBarSetup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btn_save_continue"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#10B981"
            android:text="Save Configuration &amp; Proceed"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Alternative: Join via QR Code -->
        <Button
            android:id="@+id/btn_open_qr_scanner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#1E293B"
            android:text="Join an Existing Network via QR Code"
            android:textAllCaps="false"
            android:textColor="#9AA7BD"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
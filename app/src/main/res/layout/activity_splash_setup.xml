<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f1724"
    android:padding="24dp">

    <!-- App Logo & Title Container -->
    <LinearLayout
        android:id="@+id/container_splash_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_splash_logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="HFM Logo"
            android:src="@drawable/hfm" />

        <TextView
            android:id="@+id/tv_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Hybrid File Manager"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Secure Polymorphic Data Shard System"
            android:textColor="#9AA7BD"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progressBarSplash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp" />

    </LinearLayout>

    <!-- Setup Choices (Visible only if setup is not completed) -->
    <LinearLayout
        android:id="@+id/layout_setup_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Choose how you want to connect:"
            android:textColor="#E6EEF8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Sender Choice -->
        <Button
            android:id="@+id/btn_setup_sender"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#4F46E5"
            android:text="Setup Network as Sender (Upload JSON)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Receiver Choice -->
        <Button
            android:id="@+id/btn_scan_receiver"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#10B981"
            android:text="Join Network as Receiver (Scan QR Code)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>